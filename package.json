{
  "name": "backend",
  "version": "1.0.0",
  "description": "Bach Viet Cam backend API",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon --ext ts --exec tsx src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:seed:classes": "tsx prisma/seed/ClassRoadmapSeed.ts",
    "audio:cleanup": "tsx --eval \"import AudioCleanupService from './src/modules/audio/service/AudioCleanupService.ts'; AudioCleanupService.execute().catch(() => { console.error('Không thể dọn file audio.'); process.exitCode = 1; });\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.8.0",
    "amqplib": "^2.2.0",
    "cookie": "^1.0.2",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "file-type": "^22.2.0",
    "globals": "^17.13.0",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "music-metadata": "^12.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookies": "^0.9.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.4",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vitest": "^5.0.5"
  }
}
