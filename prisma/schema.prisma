generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// TODO(M06): user management owns the account lifecycle; M03 only adds status + student code
// so imported students can exist as Pending accounts until their first Google sign-in (GBR-29, GBR-38).
enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  username           String
  role               Int
  status             UserStatus          @default(ACTIVE)
  studentCode        String?             @unique @map("student_code") @db.VarChar(50)
  identities         AuthIdentity[]
  sessions           AuthSession[]
  lecturedClasses    Class[]             @relation("ClassLecturer")
  memberships        ClassMember[]       @relation("ClassMemberStudent")
  addedMembers       ClassMember[]       @relation("ClassMemberAddedBy")
  removedMembers     ClassMember[]       @relation("ClassMemberRemovedBy")
  importLogs         StudentImportLog[]
  auditLogs          AuditLog[]
  createdPieces      Piece[]
  roadmaps           Roadmap[]
  createdAssignments AssignmentVersion[] @relation("AssignmentVersionCreatedBy")
  ownedAssignments   Assignment[]        @relation("AssignmentCreatedBy")
  submissions        Submission[]
  submissionComments SubmissionComment[]
  notifications      Notification[]
  updatedSettings    SystemSetting[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model AuthIdentity {
  id         String   @id @default(uuid())
  provider   String
  providerId String   @map("provider_id")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_identities")
}

model AuthSession {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  refreshHash String    @unique @map("refresh_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// TODO(M06): instrument catalogue is owned by M06; this is the minimum M03 needs.
model Instrument {
  id        String    @id @default(uuid())
  name      String    @unique @db.VarChar(100)
  isActive  Boolean   @default(true) @map("is_active")
  classes   Class[]
  pieces    Piece[]
  roadmaps  Roadmap[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("instruments")
}

enum ClassStatus {
  ACTIVE
  FINISHED
}

// Class name is unique per cohort, case-insensitive (DBR-02): enforced by the
// expression index "classes_cohort_lower_name_key" in the migration SQL.
model Class {
  id           String             @id @default(uuid())
  name         String             @db.VarChar(100)
  cohort       String             @db.VarChar(50)
  description  String?            @db.VarChar(500)
  instrumentId String             @map("instrument_id")
  instrument   Instrument         @relation(fields: [instrumentId], references: [id])
  lecturerId   String             @map("lecturer_id")
  lecturer     User               @relation("ClassLecturer", fields: [lecturerId], references: [id])
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  status       ClassStatus        @default(ACTIVE)
  endedAt      DateTime?          @map("ended_at")
  roadmapId    String?            @map("roadmap_id")
  roadmap      Roadmap?           @relation(fields: [roadmapId], references: [id])
  members      ClassMember[]
  assignments  Assignment[]
  submissions  Submission[]
  importLogs   StudentImportLog[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([lecturerId, status])
  @@index([instrumentId])
  @@index([roadmapId])
  @@map("classes")
}

enum ClassMemberSource {
  IMPORT
  MANUAL
}

// One active membership per (class, student): enforced by the partial index
// "class_members_active_key" (WHERE removed_at IS NULL) in the migration SQL.
// Removal is soft (GBR-39); re-adding creates a new membership row.
model ClassMember {
  id          String            @id @default(uuid())
  classId     String            @map("class_id")
  class       Class             @relation(fields: [classId], references: [id])
  studentId   String            @map("student_id")
  student     User              @relation("ClassMemberStudent", fields: [studentId], references: [id])
  source      ClassMemberSource
  importLogId String?           @map("import_log_id")
  importLog   StudentImportLog? @relation(fields: [importLogId], references: [id])
  addedById   String            @map("added_by")
  addedBy     User              @relation("ClassMemberAddedBy", fields: [addedById], references: [id])
  joinedAt    DateTime          @default(now()) @map("joined_at")
  removedAt   DateTime?         @map("removed_at")
  removedById String?           @map("removed_by")
  removedBy   User?             @relation("ClassMemberRemovedBy", fields: [removedById], references: [id])

  @@index([classId])
  @@index([studentId])
  @@index([importLogId])
  @@index([addedById])
  @@index([removedById])
  @@map("class_members")
}

enum ImportLogStatus {
  PREVIEW
  CONFIRMED
  CANCELLED
}

model StudentImportLog {
  id          String          @id @default(uuid())
  classId     String          @map("class_id")
  class       Class           @relation(fields: [classId], references: [id])
  lecturerId  String          @map("lecturer_id")
  lecturer    User            @relation(fields: [lecturerId], references: [id])
  fileName    String          @map("file_name") @db.VarChar(255)
  fileType    String          @map("file_type") @db.VarChar(10)
  totalRows   Int             @map("total_rows")
  validRows   Int             @map("valid_rows")
  errorRows   Int             @map("error_rows")
  rows        Json
  status      ImportLogStatus @default(PREVIEW)
  members     ClassMember[]
  createdAt   DateTime        @default(now()) @map("created_at")
  confirmedAt DateTime?       @map("confirmed_at")

  @@index([classId])
  @@index([lecturerId])
  @@map("student_import_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum PieceKind {
  FINGER_EXERCISE
  SONG
}

// TODO(M02): minimal music library — M02 owns pieces, sheet music and the library screens.
model Piece {
  id                 String                @id @default(uuid())
  title              String                @db.VarChar(200)
  instrumentId       String                @map("instrument_id")
  instrument         Instrument            @relation(fields: [instrumentId], references: [id])
  kind               PieceKind
  defaultBpm         Int?                  @map("default_bpm")
  isVisible          Boolean               @default(true) @map("is_visible")
  createdById        String?               @map("created_by")
  createdBy          User?                 @relation(fields: [createdById], references: [id])
  roadmapUses        RoadmapWeekExercise[]
  assignmentVersions AssignmentVersion[]
  createdAt          DateTime              @default(now()) @map("created_at")

  @@index([instrumentId, kind, isVisible])
  @@index([createdById])
  @@map("pieces")
}

// One row = one immutable roadmap version of an instrument (UC-11). Never updated after insert.
model Roadmap {
  id           String        @id @default(uuid())
  instrumentId String        @map("instrument_id")
  instrument   Instrument    @relation(fields: [instrumentId], references: [id])
  version      Int
  createdById  String        @map("created_by")
  createdBy    User          @relation(fields: [createdById], references: [id])
  weeks        RoadmapWeek[]
  classes      Class[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@unique([instrumentId, version])
  @@index([createdById])
  @@map("roadmaps")
}

// week_number 1..6 is enforced by the CHECK constraint "roadmap_weeks_week_number_check" in the migration SQL.
model RoadmapWeek {
  id         String                @id @default(uuid())
  roadmapId  String                @map("roadmap_id")
  roadmap    Roadmap               @relation(fields: [roadmapId], references: [id])
  weekNumber Int                   @map("week_number") @db.SmallInt
  title      String                @db.VarChar(100)
  content    String                @db.VarChar(1000)
  exercises  RoadmapWeekExercise[]

  @@unique([roadmapId, weekNumber])
  @@map("roadmap_weeks")
}

model RoadmapWeekExercise {
  id            String      @id @default(uuid())
  roadmapWeekId String      @map("roadmap_week_id")
  roadmapWeek   RoadmapWeek @relation(fields: [roadmapWeekId], references: [id])
  pieceId       String      @map("piece_id")
  piece         Piece       @relation(fields: [pieceId], references: [id])
  sortOrder     Int         @map("sort_order")

  @@unique([roadmapWeekId, sortOrder])
  @@unique([roadmapWeekId, pieceId])
  @@index([pieceId])
  @@map("roadmap_week_exercises")
}

// TODO(M06): system configuration is owned by M06; M03 only needs the grading thresholds.
model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.VarChar(500)
  updatedById String?  @map("updated_by")
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([updatedById])
  @@map("system_settings")
}

// TODO(M06): notification centre is owned by M06; M03 only creates rows.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(500)
  link      String    @db.VarChar(300)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AssignmentKind {
  SOLO
  ENSEMBLE
  BONUS
  OTHER
}

// Practice post for the whole class (user decision 16/10). Content lives in immutable versions.
model Assignment {
  id               String              @id @default(uuid())
  classId          String              @map("class_id")
  class            Class               @relation(fields: [classId], references: [id])
  createdById      String              @map("created_by")
  createdBy        User                @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  status           AssignmentStatus    @default(DRAFT)
  currentVersionId String?             @unique @map("current_version_id")
  currentVersion   AssignmentVersion?  @relation("AssignmentCurrentVersion", fields: [currentVersionId], references: [id])
  versions         AssignmentVersion[] @relation("AssignmentVersions")
  submissions      Submission[]
  publishedAt      DateTime?           @map("published_at")
  closedAt         DateTime?           @map("closed_at")
  deletedAt        DateTime?           @map("deleted_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([classId, status])
  @@index([createdById])
  @@map("assignments")
}

model AssignmentVersion {
  id           String         @id @default(uuid())
  assignmentId String         @map("assignment_id")
  assignment   Assignment     @relation("AssignmentVersions", fields: [assignmentId], references: [id])
  currentOf    Assignment?    @relation("AssignmentCurrentVersion")
  version      Int
  title        String         @db.VarChar(200)
  description  String?        @db.VarChar(1000)
  kind         AssignmentKind
  pieceId      String?        @map("piece_id")
  piece        Piece?         @relation(fields: [pieceId], references: [id])
  requiredBpm  Int?           @map("required_bpm")
  createdById  String         @map("created_by")
  createdBy    User           @relation("AssignmentVersionCreatedBy", fields: [createdById], references: [id])
  submissions  Submission[]
  createdAt    DateTime       @default(now()) @map("created_at")

  @@unique([assignmentId, version])
  @@index([pieceId])
  @@index([createdById])
  @@map("assignment_versions")
}

enum SubmissionStatus {
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

// TODO(M01): recording upload + AI analysis are owned by M01, which will write this table.
model Submission {
  id                  String             @id @default(uuid())
  assignmentId        String             @map("assignment_id")
  assignment          Assignment         @relation(fields: [assignmentId], references: [id])
  assignmentVersionId String             @map("assignment_version_id")
  assignmentVersion   AssignmentVersion  @relation(fields: [assignmentVersionId], references: [id])
  classId             String             @map("class_id")
  class               Class              @relation(fields: [classId], references: [id])
  studentId           String             @map("student_id")
  student             User               @relation(fields: [studentId], references: [id])
  audioUrl            String             @map("audio_url") @db.VarChar(500)
  status              SubmissionStatus   @default(PROCESSING)
  accuracy            Decimal?           @db.Decimal(5, 2)
  tempoDeviation      Decimal?           @map("tempo_deviation") @db.Decimal(6, 2)
  submittedAt         DateTime           @default(now()) @map("submitted_at")
  analyzedAt          DateTime?          @map("analyzed_at")
  comment             SubmissionComment?

  @@index([assignmentId, studentId])
  @@index([classId, studentId])
  @@index([assignmentVersionId])
  @@index([studentId])
  @@map("submissions")
}

// One lecturer comment per submission; editing overwrites it (no history, user decision 16/10).
model SubmissionComment {
  id           String     @id @default(uuid())
  submissionId String     @unique @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])
  lecturerId   String     @map("lecturer_id")
  lecturer     User       @relation(fields: [lecturerId], references: [id])
  content      String     @db.VarChar(2000)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([lecturerId])
  @@map("submission_comments")
}
