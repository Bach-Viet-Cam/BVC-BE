generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
}

enum ConfigValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum ConfigGroup {
  FILE_LIMIT
  SCORING
  PRACTICE_RULE
}

model User {
  id                        String                   @id @default(uuid())
  email                     String                   @unique
  username                  String
  role                      Int
  status                    UserStatus               @default(ACTIVE)
  studentCode               String?                  @unique @map("student_code")
  lastLoginAt               DateTime?                @map("last_login_at")
  identities                AuthIdentity[]
  sessions                  AuthSession[]
  ownedPieces               Piece[]                  @relation("PieceOwner")
  uploadedSheetMusic        SheetMusic[]             @relation("SheetMusicUploader")
  createdChallenges         Challenge[]              @relation("ChallengeCreatedBy")
  uploadedMediaFiles        MediaFile[]              @relation("MediaFileUploader")
  savedItems                SavedItem[]
  ownedClasses              Class[]
  classMemberships          ClassMember[]
  addedMembers              ClassMember[]            @relation("ClassMemberAddedBy")
  removedMembers            ClassMember[]            @relation("ClassMemberRemovedBy")
  importLogs                StudentImportLog[]
  auditLogs                 AuditLog[]
  roadmaps                  Roadmap[]
  createdAssignments        Assignment[]             @relation("AssignmentCreatedBy")
  createdAssignmentVersions AssignmentVersion[]      @relation("AssignmentVersionCreatedBy")
  submissionComments        SubmissionComment[]
  submissions               Submission[]
  audioUploads              AudioUpload[]
  audioEvaluations          AudioEvaluationRequest[]
  leaderboardEntries        LeaderboardEntry[]
  createdNotifications      Notification[]           @relation("NotificationCreator")
  notifications             UserNotification[]       @relation("UserNotifications")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")

  @@map("users")
}

model AuthIdentity {
  id         String   @id @default(uuid())
  provider   String
  providerId String   @map("provider_id")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_identities")
}

model AuthSession {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  refreshHash String    @unique @map("refresh_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// ---------- Catalog: M02 genre/level categories; instruments and system config are shared with M06 ----------

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum CategoryType {
  GENRE
  LEVEL
}

model Instrument {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  description      String?
  // Pitch range sent to the AI service for reference-recording analysis
  fminHz           Float             @default(80) @map("fmin_hz")
  fmaxHz           Float             @default(2000) @map("fmax_hz")
  toleranceCents   Int               @default(30) @map("tolerance_cents")
  isActive         Boolean           @default(true) @map("is_active")
  pieces           PieceInstrument[]
  sheetMusic       SheetMusic[]
  challenges       Challenge[]
  classes          Class[]
  classMembers     ClassMember[]
  roadmaps         Roadmap[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")

  @@map("instruments")
}

model Category {
  id              String       @id @default(uuid())
  type            CategoryType
  name            String
  description     String?
  displayOrder    Int          @default(0) @map("display_order")
  status          ActiveStatus @default(ACTIVE)
  genrePieces     Piece[]      @relation("PieceGenre")
  levelPieces     Piece[]      @relation("PieceLevel")
  levelSheetMusic SheetMusic[] @relation("SheetMusicLevel")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([type, name])
  @@map("category")
}

model SystemConfig {
  id          String          @id @default(uuid())
  key         String          @unique
  value       String
  valueType   ConfigValueType @map("value_type")
  group       ConfigGroup
  label       String
  description String?
  updatedById String?         @map("updated_by_id")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("system_configs")
}

// ---------- M02: Music content & sheet library ----------

enum PieceKind {
  FINGER_EXERCISE
  SONG
}

enum Visibility {
  PUBLIC
  HIDDEN
}

enum Moderation {
  NORMAL
  ADMIN_HIDDEN
}

enum SheetKind {
  MAIN
  LEVEL
}

enum AnalysisStatus {
  NONE
  PROCESSING
  READY
  ERROR
}

enum MediaKind {
  COVER
  SHEET
  AUDIO
  VIDEO
}

enum MediaStatus {
  PENDING
  READY
}

enum SavedTargetType {
  PIECE
  SHEET_MUSIC
}

model MediaFile {
  id               String       @id @default(uuid())
  kind             MediaKind
  status           MediaStatus  @default(PENDING)
  storageKey       String       @unique @map("storage_key")
  originalName     String       @map("original_name")
  mimeType         String       @map("mime_type")
  sizeBytes        Int          @map("size_bytes")
  durationSec      Int?         @map("duration_sec")
  pageCount        Int?         @map("page_count")
  uploadedById     String       @map("uploaded_by")
  uploadedBy       User         @relation("MediaFileUploader", fields: [uploadedById], references: [id])
  coverOfPieces    Piece[]      @relation("PieceCover")
  sheetOf          SheetMusic[] @relation("SheetMusicSheetFile")
  referenceAudioOf SheetMusic[] @relation("SheetMusicReferenceAudio")
  tutorialVideoOf  SheetMusic[] @relation("SheetMusicTutorialVideo")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([uploadedById])
  @@map("media_file")
}

model Piece {
  id                 String                @id @default(uuid())
  ownerId            String                @map("owner_id")
  owner              User                  @relation("PieceOwner", fields: [ownerId], references: [id])
  title              String                @db.VarChar(200)
  composer           String?               @db.VarChar(200)
  description        String?               @db.VarChar(1000)
  // Default tempo for assignments and ensemble practice
  bpm                Int                   @default(90)
  coverFileId        String?               @map("cover_file_id")
  coverFile          MediaFile?            @relation("PieceCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  genreId            String                @map("genre_id")
  genre              Category              @relation("PieceGenre", fields: [genreId], references: [id])
  levelId            String                @map("level_id")
  level              Category              @relation("PieceLevel", fields: [levelId], references: [id])
  // Node in the admin content-category tree
  categoryId         String?               @map("category_id")
  category           ContentCategory?      @relation(fields: [categoryId], references: [id])
  visibility         Visibility            @default(HIDDEN)
  moderation         Moderation            @default(NORMAL)
  moderationReason   String?               @map("moderation_reason")
  // Lowercase, diacritic-free copies for accent-insensitive search and A→Z sorting
  titleNormalized    String                @default("") @map("title_normalized")
  composerNormalized String                @default("") @map("composer_normalized")
  searchText         String                @default("") @map("search_text")
  instruments        PieceInstrument[]
  sheetMusic         SheetMusic[]
  savedItems         SavedItem[]
  // Roadmap exercises are FINGER_EXERCISE pieces; everything else is a SONG
  kind               PieceKind             @default(SONG)
  roadmapUses        RoadmapWeekExercise[]
  submissions        Submission[]
  deletedAt          DateTime?             @map("deleted_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at")

  challenges Challenge[]
  @@index([ownerId, updatedAt])
  @@index([visibility, moderation, createdAt])
  @@map("pieces")
}

model PieceInstrument {
  pieceId      String     @map("piece_id")
  piece        Piece      @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  instrumentId String     @map("instrument_id")
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@id([pieceId, instrumentId])
  @@map("piece_instrument")
}

model SheetMusic {
  id                   String         @id @default(uuid())
  pieceId              String         @map("piece_id")
  piece                Piece          @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  instrumentId         String         @map("instrument_id")
  instrument           Instrument     @relation(fields: [instrumentId], references: [id])
  kind                 SheetKind
  // instrument_id when kind = MAIN, NULL otherwise; unique with piece_id → max one main per (piece, instrument) (GBR-55)
  mainInstrumentId     String?        @map("main_instrument_id")
  name                 String         @db.VarChar(100)
  levelId              String         @map("level_id")
  level                Category       @relation("SheetMusicLevel", fields: [levelId], references: [id])
  description          String?        @db.VarChar(500)
  sheetFileId          String         @map("sheet_file_id")
  sheetFile            MediaFile      @relation("SheetMusicSheetFile", fields: [sheetFileId], references: [id])
  referenceAudioId     String?        @map("reference_audio_id")
  referenceAudio       MediaFile?     @relation("SheetMusicReferenceAudio", fields: [referenceAudioId], references: [id])
  tutorialVideoId      String?        @map("tutorial_video_id")
  tutorialVideo        MediaFile?     @relation("SheetMusicTutorialVideo", fields: [tutorialVideoId], references: [id])
  durationSec          Int?           @map("duration_sec")
  visibility           Visibility     @default(PUBLIC)
  moderation           Moderation     @default(NORMAL)
  analysisStatus       AnalysisStatus @default(NONE) @map("analysis_status")
  analysisFileUrl      String?        @map("analysis_file_url")
  analysisError        String?        @map("analysis_error")
  analysisJobId        String?        @map("analysis_job_id")
  timeSignatureMissing Boolean        @default(false) @map("time_signature_missing")
  uploaderId           String         @map("uploader_id")
  uploader             User           @relation("SheetMusicUploader", fields: [uploaderId], references: [id])
  savedItems           SavedItem[]
  submissions          Submission[]
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  assignments          Assignment[]
  assignmentVersions   AssignmentVersion[]
  challenges Challenge[]
  @@unique([pieceId, name])
  @@unique([pieceId, mainInstrumentId])
  @@index([pieceId, instrumentId])
  @@map("sheet_music")
}

model SavedItem {
  id           String          @id @default(uuid())
  studentId    String          @map("student_id")
  student      User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetType   SavedTargetType @map("target_type")
  // Same value as piece_id or sheet_music_id; keeps the uniqueness rule free of NULL columns (R-06)
  targetId     String          @map("target_id")
  pieceId      String?         @map("piece_id")
  piece        Piece?          @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  sheetMusicId String?         @map("sheet_music_id")
  sheetMusic   SheetMusic?     @relation(fields: [sheetMusicId], references: [id], onDelete: Cascade)
  savedAt      DateTime        @default(now()) @map("saved_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([studentId, targetType, targetId])
  @@index([studentId, savedAt])
  @@map("saved_item")
}

// ---------- Classes, ensemble, notifications, audio ----------

enum ClassStatus {
  ACTIVE
  ENDED
}

enum AssignmentType {
  PRACTICE
  RHYTHM
  RECORDING
  SHEET
  BONUS
  EXAM
}

enum SubmissionStatus {
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

// Job of the AI pipeline currently running for a practice submission (GBR-63/64)
enum SubmissionStage {
  QUALITY_CHECK
  AUDIO_ANALYSIS
  COMPARISON
  FEEDBACK
}

enum PracticeMode {
  SOLO
  ENSEMBLE
}

model ContentCategory {
  id        String            @id @default(uuid())
  name      String
  parentId  String?           @map("parent_id")
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at")
  parent    ContentCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ContentCategory[] @relation("CategoryTree")
  pieces    Piece[]

  @@index([parentId])
  @@map("content_categories")
}

// Class name is unique per cohort, case-insensitive (DBR-02): enforced in ClassService.
model Class {
  id                 String             @id @default(uuid())
  name               String
  cohort             String             @default("") @db.VarChar(50)
  description        String?            @db.VarChar(500)
  instrumentId       String             @map("instrument_id")
  ownerId            String             @map("owner_id")
  startDate          DateTime           @map("start_date")
  endDate            DateTime           @default(now()) @map("end_date")
  status             ClassStatus        @default(ACTIVE)
  endedAt            DateTime?          @map("ended_at")
  roadmapId          String?            @map("roadmap_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  instrument         Instrument         @relation(fields: [instrumentId], references: [id])
  owner              User               @relation(fields: [ownerId], references: [id])
  roadmap            Roadmap?           @relation(fields: [roadmapId], references: [id])
  members            ClassMember[]
  assignments        Assignment[]
  challengeClasses   ChallengeClass[]
  importLogs         StudentImportLog[]
  leaderboardEntries LeaderboardEntry[]

  @@map("classes")
}

enum ClassMemberSource {
  IMPORT
  MANUAL
}

// Removal is soft (GBR-39): removedAt is set and re-adding creates a new row, so there is no unique (classId, userId).
// "One active membership per student" is enforced in MemberService.
model ClassMember {
  id           String            @id @default(uuid())
  classId      String            @map("class_id")
  userId       String            @map("user_id")
  instrumentId String            @map("instrument_id")
  source       ClassMemberSource @default(MANUAL)
  importLogId  String?           @map("import_log_id")
  addedById    String?           @map("added_by")
  joinedAt     DateTime          @default(now()) @map("joined_at")
  removedAt    DateTime?         @map("removed_at")
  removedById  String?           @map("removed_by")
  createdAt    DateTime          @default(now()) @map("created_at")
  class        Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id])
  instrument   Instrument        @relation(fields: [instrumentId], references: [id])
  importLog    StudentImportLog? @relation(fields: [importLogId], references: [id])
  addedBy      User?             @relation("ClassMemberAddedBy", fields: [addedById], references: [id])
  removedBy    User?             @relation("ClassMemberRemovedBy", fields: [removedById], references: [id])

  @@index([userId])
  @@map("class_members")
}

enum ImportLogStatus {
  PREVIEW
  CONFIRMED
  CANCELLED
}

model StudentImportLog {
  id          String          @id @default(uuid())
  classId     String          @map("class_id")
  lecturerId  String          @map("lecturer_id")
  fileName    String          @map("file_name") @db.VarChar(255)
  fileType    String          @map("file_type") @db.VarChar(10)
  totalRows   Int             @map("total_rows")
  validRows   Int             @map("valid_rows")
  errorRows   Int             @map("error_rows")
  rows        Json
  status      ImportLogStatus @default(PREVIEW)
  createdAt   DateTime        @default(now()) @map("created_at")
  confirmedAt DateTime?       @map("confirmed_at")
  class       Class           @relation(fields: [classId], references: [id])
  lecturer    User            @relation(fields: [lecturerId], references: [id])
  members     ClassMember[]

  @@map("student_import_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

// One row = one immutable roadmap version of an instrument (UC-11). Never updated after insert.
model Roadmap {
  id           String        @id @default(uuid())
  instrumentId String        @map("instrument_id")
  version      Int
  createdById  String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  instrument   Instrument    @relation(fields: [instrumentId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  weeks        RoadmapWeek[]
  classes      Class[]

  @@unique([instrumentId, version])
  @@map("roadmaps")
}

// week_number 1..6 is validated in RoadmapValidator.
model RoadmapWeek {
  id         String                @id @default(uuid())
  roadmapId  String                @map("roadmap_id")
  weekNumber Int                   @map("week_number") @db.SmallInt
  title      String                @db.VarChar(100)
  content    String                @db.VarChar(1000)
  roadmap    Roadmap               @relation(fields: [roadmapId], references: [id])
  exercises  RoadmapWeekExercise[]

  @@unique([roadmapId, weekNumber])
  @@map("roadmap_weeks")
}

model RoadmapWeekExercise {
  id            String      @id @default(uuid())
  roadmapWeekId String      @map("roadmap_week_id")
  pieceId       String      @map("piece_id")
  sortOrder     Int         @map("sort_order")
  roadmapWeek   RoadmapWeek @relation(fields: [roadmapWeekId], references: [id])
  piece         Piece       @relation(fields: [pieceId], references: [id])

  @@unique([roadmapWeekId, sortOrder])
  @@unique([roadmapWeekId, pieceId])
  @@map("roadmap_week_exercises")
}

model Assignment {
  id               String              @id @default(uuid())
  classId          String              @map("class_id")
  sheetMusicId     String?             @map("sheet_music_id")
  title            String
  type             AssignmentType
  description      String              @default("")
  weekNo           Int?                @map("week_no")
  deadline         DateTime
  targetBpm        Int?                @map("target_bpm")
  minAccuracy      Int?                @map("min_accuracy")
  maxSubmissions   Int                 @default(3) @map("max_submissions")
  isPublished      Boolean             @default(false) @map("is_published")
  bonusPoints      Int?                @map("bonus_points")
  createdAt        DateTime            @default(now()) @map("created_at")
  // Lecturer lifecycle (M03). title / type / description / sheetMusicId / targetBpm / isPublished mirror the current version
  // so the student-side readers keep working; deadline mirrors the class end date.
  status           AssignmentStatus    @default(PUBLISHED)
  createdById      String?             @map("created_by")
  currentVersionId String?             @unique @map("current_version_id")
  publishedAt      DateTime?           @map("published_at")
  closedAt         DateTime?           @map("closed_at")
  deletedAt        DateTime?           @map("deleted_at")
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at")
  class            Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  sheetMusic       SheetMusic?         @relation(fields: [sheetMusicId], references: [id])
  createdBy        User?               @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  currentVersion   AssignmentVersion?  @relation("AssignmentCurrentVersion", fields: [currentVersionId], references: [id])
  versions         AssignmentVersion[] @relation("AssignmentVersions")
  rubric           Rubric?
  submissions      Submission[]

  @@map("assignments")
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AssignmentKind {
  SOLO
  ENSEMBLE
  BONUS
  OTHER
}

// Immutable content versions of a lecturer assignment (edit = new version).
model AssignmentVersion {
  id           String         @id @default(uuid())
  assignmentId String         @map("assignment_id")
  version      Int
  title        String         @db.VarChar(200)
  description  String?        @db.VarChar(1000)
  kind         AssignmentKind
  sheetMusicId String?        @map("sheet_music_id")
  requiredBpm  Int?           @map("required_bpm")
  createdById  String         @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  assignment   Assignment     @relation("AssignmentVersions", fields: [assignmentId], references: [id], onDelete: Cascade)
  currentOf    Assignment?    @relation("AssignmentCurrentVersion")
  sheetMusic   SheetMusic?    @relation(fields: [sheetMusicId], references: [id])
  createdBy    User           @relation("AssignmentVersionCreatedBy", fields: [createdById], references: [id])
  submissions  Submission[]

  @@unique([assignmentId, version])
  @@map("assignment_versions")
}

model Rubric {
  id           String            @id @default(uuid())
  assignmentId String            @unique @map("assignment_id")
  assignment   Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criteria     RubricCriterion[]

  @@map("rubrics")
}

model RubricCriterion {
  id       String @id @default(uuid())
  rubricId String @map("rubric_id")
  name     String
  weight   Int
  position Int    @default(0)
  rubric   Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  @@index([rubricId])
  @@map("rubric_criteria")
}

// A practice recording sent for AI analysis. assignmentId is empty for free practice on a library piece.
model Submission {
  id                  String             @id @default(uuid())
  assignmentId        String?            @map("assignment_id")
  pieceId             String             @map("piece_id")
  sheetMusicId        String?            @map("sheet_music_id")
  studentId           String             @map("student_id")
  studentUploadId     String?            @map("student_upload_id")
  status              SubmissionStatus   @default(PROCESSING)
  practiceMode        PracticeMode       @default(SOLO) @map("practice_mode")
  accuracy            Float?
  fileUrl             String?            @map("file_url")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at")
  assignmentVersionId String?            @map("assignment_version_id")
  tempoDeviation      Float?             @map("tempo_deviation")
  analyzedAt          DateTime?          @map("analyzed_at")
  // Rhythm service job: ids, queue publication state and the attempt that callbacks must match
  evaluationId        String?            @unique @map("evaluation_id")
  messageId           String?            @unique @map("message_id")
  publicationState    String?            @map("publication_state")
  attempt             Int                @default(1)
  stage               SubmissionStage?
  stageStartedAt      DateTime?          @map("stage_started_at")
  // GBR-59: retries used, when the next retry opens, and when the file was deleted after the last one (GBR-62)
  retryCount          Int                @default(0) @map("retry_count")
  retryAvailableAt    DateTime?          @map("retry_available_at")
  fileDeletedAt       DateTime?          @map("file_deleted_at")
  result              Json?
  aiFeedback          String?            @map("ai_feedback")
  rejectReason        String?            @map("reject_reason")
  errorCode           String?            @map("error_code")
  errorMessage        String?            @map("error_message")
  assignment          Assignment?        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentVersion   AssignmentVersion? @relation(fields: [assignmentVersionId], references: [id])
  piece               Piece              @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  sheetMusic          SheetMusic?        @relation(fields: [sheetMusicId], references: [id], onDelete: SetNull)
  studentUpload       AudioUpload?       @relation(fields: [studentUploadId], references: [id], onDelete: SetNull)
  student             User               @relation(fields: [studentId], references: [id])
  comment             SubmissionComment?

  @@index([assignmentId, studentId])
  @@index([studentId, pieceId, status])
  @@map("submissions")
}

// One lecturer comment per submission; editing overwrites it (no history).
model SubmissionComment {
  id           String     @id @default(uuid())
  submissionId String     @unique @map("submission_id")
  lecturerId   String     @map("lecturer_id")
  content      String     @db.VarChar(2000)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  lecturer     User       @relation(fields: [lecturerId], references: [id])

  @@map("submission_comments")
}

enum NotificationType {
  DEADLINE
  ANNOUNCEMENT
  SYSTEM
  BONUS
}

enum NotificationTarget {
  ALL
  STUDENT
  TEACHER
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENT
}

model Notification {
  id             String             @id @default(uuid())
  title          String
  body           String
  type           NotificationType
  target         NotificationTarget @default(ALL)
  status         NotificationStatus @default(DRAFT)
  scheduledAt    DateTime?          @map("scheduled_at")
  sentAt         DateTime?          @map("sent_at")
  recipientCount Int                @default(0) @map("recipient_count")
  link           String?
  createdById    String             @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  createdBy      User               @relation("NotificationCreator", fields: [createdById], references: [id])
  recipients     UserNotification[]

  @@index([status, scheduledAt])
  @@map("notifications")
}

model UserNotification {
  id             String       @id @default(uuid())
  notificationId String       @map("notification_id")
  userId         String       @map("user_id")
  isRead         Boolean      @default(false) @map("is_read")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation("UserNotifications", fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@map("user_notifications")
}

model AudioUpload {
  id                  String                   @id @default(uuid())
  ownerId             String                   @map("owner_id")
  provider            String
  key                 String
  url                 String                   @unique
  originalName        String                   @map("original_name")
  contentType         String                   @map("content_type")
  sizeBytes           Int                      @map("size_bytes")
  createdAt           DateTime                 @default(now()) @map("created_at")
  deletingAt          DateTime?                @map("deleting_at")
  owner               User                     @relation(fields: [ownerId], references: [id])
  templateEvaluations AudioEvaluationRequest[] @relation("AudioTemplate")
  studentEvaluations  AudioEvaluationRequest[] @relation("AudioStudent")
  submissions         Submission[]

  @@unique([provider, key])
  @@index([ownerId])
  @@index([createdAt])
  @@map("audio_uploads")
}

model AudioEvaluationRequest {
  evaluationId     String      @id @map("evaluation_id")
  messageId        String      @unique @map("message_id")
  ownerId          String      @map("owner_id")
  templateUploadId String      @map("template_upload_id")
  studentUploadId  String      @map("student_upload_id")
  instrumentCode   String      @map("instrument_code")
  publicationState String      @default("publishing") @map("publication_state")
  lastErrorCode    String?     @map("last_error_code")
  createdAt        DateTime    @default(now()) @map("created_at")
  publishedAt      DateTime?   @map("published_at")
  owner            User        @relation(fields: [ownerId], references: [id])
  templateUpload   AudioUpload @relation("AudioTemplate", fields: [templateUploadId], references: [id], onDelete: Restrict)
  studentUpload    AudioUpload @relation("AudioStudent", fields: [studentUploadId], references: [id], onDelete: Restrict)

  @@index([ownerId, createdAt])
  @@index([templateUploadId])
  @@index([studentUploadId])
  @@map("audio_evaluation_requests")
}

enum LeaderboardCategory {
  OVERALL
  ACCURACY
  IMPROVEMENT
  STREAK
  ACTIVITY
}

// UC-17 (DBR-14): periodic ranking snapshot of one semester (semester = Class.cohort); the API reads only from here.
model LeaderboardSnapshot {
  id           String             @id @default(uuid())
  semester     String             @db.VarChar(50)
  periodStart  DateTime           @map("period_start") @db.Date
  periodEnd    DateTime           @map("period_end") @db.Date
  weekStart    DateTime           @map("week_start") @db.Date
  snapshotDate DateTime           @map("snapshot_date") @db.Date
  startedAt    DateTime           @map("started_at")
  generatedAt  DateTime           @map("generated_at")
  durationMs   Int                @map("duration_ms")
  entries      LeaderboardEntry[]

  @@unique([semester, snapshotDate])
  @@index([semester, generatedAt])
  @@map("leaderboard_snapshots")
}

model LeaderboardEntry {
  id         String              @id @default(uuid())
  snapshotId String              @map("snapshot_id")
  category   LeaderboardCategory
  studentId  String              @map("student_id")
  classId    String              @map("class_id")
  rank       Int
  // Display order after tie-break; used for paging
  position   Int
  // Value shown on the tab
  value      Float
  // OVERALL only: raw + normalised criteria
  criteria   Json?
  snapshot   LeaderboardSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  student    User                @relation(fields: [studentId], references: [id])
  class      Class               @relation(fields: [classId], references: [id])

  @@unique([snapshotId, category, studentId])
  @@index([snapshotId, category, position])
  @@map("leaderboard_entries")
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
}

model Challenge {
  id             String          @id @default(uuid())
  title          String
  description    String?
  instrumentId   String?         @map("instrument_id")
  pieceId        String?         @map("piece_id")
  sheetMusicId   String?         @map("sheet_music_id")
  createdById    String          @map("created_by")
  status         ChallengeStatus @default(DRAFT)
  startsAt       DateTime?       @map("starts_at")
  endsAt         DateTime?       @map("ends_at")
  minAccuracy    Int?            @map("min_accuracy")
  requiredBpm    Int?            @map("required_bpm")
  maxSubmissions Int             @default(3) @map("max_submissions")
  pausedAt       DateTime?       @map("paused_at")
  publishedAt    DateTime?       @map("published_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  instrument     Instrument?     @relation(fields: [instrumentId], references: [id])
  piece          Piece?          @relation(fields: [pieceId], references: [id])
  sheetMusic     SheetMusic?     @relation(fields: [sheetMusicId], references: [id])
  createdBy      User            @relation("ChallengeCreatedBy", fields: [createdById], references: [id])
  classes        ChallengeClass[]

  @@index([createdById, startsAt])
  @@index([status, startsAt, endsAt])
  @@map("challenges")
}

model ChallengeClass {
  challengeId String    @map("challenge_id")
  classId     String    @map("class_id")
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  class       Class     @relation(fields: [classId], references: [id])

  @@id([challengeId, classId])
  @@map("challenge_classes")
}
