PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Inside Docker container: bvc-postgres:5432. Localhost from host machine: localhost:5432
DATABASE_URL=postgresql://bvc_admin:your-postgres-password@bvc-postgres:5432/bachvietcam_staging
# Optional for tests (defaults to postgresql://postgres:postgres@localhost:5432/bvc_m02_test)
TEST_DATABASE_URL=
# Redis for the BullMQ analysis queue. Empty → in-memory queue (dev only, jobs lost on restart)
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Public base URL of this API (signed local-storage URLs and AI callback URL are built from it)
PUBLIC_API_URL=http://localhost:3000

# File storage: "local" (disk, served by the API – dev/test) or "s3" (S3 / MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# HMAC secret for local signed URLs (falls back to JWT_SECRET)
STORAGE_SIGNING_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bvc-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Python AI service (reference-recording analysis, JOB-01/02)
AI_SERVICE_URL=http://localhost:8001
# Shared secret the AI service sends in X-Callback-Secret when calling back
AI_CALLBACK_SECRET=
# Delay between dispatch retries (3 attempts)
AI_RETRY_DELAY_MS=30000
# Dev only: mount a fake AI service at /api/v1/internal/mock-ai and point AI_SERVICE_URL to it
MOCK_AI_SERVICE=false
MOCK_AI_DELAY_MS=3000
