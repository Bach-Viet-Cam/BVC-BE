PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Inside Docker container: bvc-postgres:5432. Localhost from host machine: localhost:5432
DATABASE_URL=postgresql://bvc_admin:your-postgres-password@bvc-postgres:5432/bachvietcam_staging
# Local dev DB started by `npm run db:up` (docker-compose.dev.yml):
# DATABASE_URL=postgresql://bvc:bvc_local@localhost:5433/bvc_dev
# Database used by `npm test` integration tests. It is truncated between tests: never point it at a shared DB.
TEST_DATABASE_URL=postgresql://bvc:bvc_local@localhost:5433/bvc_test
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
