PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Inside Docker container: bvc-postgres:5432. Localhost from host machine: localhost:5432
DATABASE_URL=postgresql://bvc_admin:your-postgres-password@bvc-postgres:5432/bachvietcam_staging
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Storage audio: nhà cung cấp hiện được hỗ trợ là local.
FILE_STORAGE_PROVIDER=local
# Thư mục tuyệt đối hoặc tương đối với working directory của BE.
FILE_STORAGE_LOCAL_ROOT=uploads
# Origin public của BE, không kèm /uploads. Worker phải truy cập được URL này.
FILE_STORAGE_PUBLIC_BASE_URL=https://your-public-backend.example.com
# Cùng broker/vhost với Rhythm Service.
RABBITMQ_URL=amqps://user:password@your-rabbitmq-host/vhost
RHYTHM_SERVICE_BASE_URL=http://localhost:8001
# Khớp RHYTHM_SERVICE_INTERNAL_API_KEY phía Rhythm; không đưa key ra FE.
RHYTHM_SERVICE_INTERNAL_API_KEY=
