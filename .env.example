# Copy thành .env rồi điền các giá trị <...>. Không commit .env.

PORT=8000
NODE_ENV=development
# Origin trình duyệt được phép gọi API, cách nhau bởi dấu phẩy; APP_ORIGIN dùng khi không khai báo CORS_ORIGINS
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Postgres local (docker-compose.dev.yml, cổng 5433). Trong Docker dùng host bvc-postgres:5432
DATABASE_URL="postgresql://bvc_admin:<password>@127.0.0.1:5433/bachvietcam_dev"
# Không bắt buộc, cho integration test (mặc định postgresql://postgres:postgres@localhost:5432/bvc_m02_test)
TEST_DATABASE_URL=

GOOGLE_CLIENT_ID=<google-oauth-client-id>
JWT_SECRET=<random-secret>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Lưu file trên đĩa, phục vụ tĩnh tại /uploads; hiện chỉ hỗ trợ provider local
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_ROOT=uploads
# Origin của BE (không kèm /uploads) để tạo link file và link upload; mặc định http://localhost:${PORT}
FILE_STORAGE_PUBLIC_BASE_URL=http://localhost:8000

# Hàng đợi chấm bài (RabbitMQ) và Rhythm service
RABBITMQ_URL=amqps://<user>:<password>@<rabbitmq-host>/<vhost>
RHYTHM_SERVICE_BASE_URL=http://localhost:8001
RHYTHM_SERVICE_INTERNAL_API_KEY=<cùng giá trị với Rhythm service>
AI_CALLBACK_SECRET=<cùng giá trị với RHYTHM_SERVICE_CALLBACK_SECRET của Rhythm service>
